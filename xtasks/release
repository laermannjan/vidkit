#!/usr/bin/env bash
#MISE description="Tag a merged release, or refresh the release pull request"
#
# CalVer, YYYY.M.PATCH. Same month bumps the patch, a new month resets it to 0.
# A merge to main is never a release. Merging the release PR is.
set -euo pipefail

if [[ -z ${GITHUB_ACTIONS:-} ]]; then
	echo "CI only: this force-pushes the release branch" >&2
	exit 1
fi

# The numeric id is what GitHub matches a noreply address against. Losing it
# costs attribution on the release commit, which is not worth failing a release
# for, so this degrades rather than aborting.
bot="${BOT_SLUG:?the workflow must pass the app slug}"
git config user.name "${bot}[bot]"
if bot_id="$(gh api "/users/${bot}%5Bbot%5D" --jq .id 2>/dev/null)" && [[ -n $bot_id ]]; then
	git config user.email "${bot_id}+${bot}[bot]@users.noreply.github.com"
else
	echo "could not resolve ${bot}[bot]; release commits will show an unlinked author" >&2
	git config user.email "${bot}[bot]@users.noreply.github.com"
fi

# The heading is dropped here but kept in CHANGELOG.md: a release is already
# titled with its tag.
notes() {
	local out=""
	out="$(git-cliff --strip all --latest | sed '/^## \[/d' | sed '/./,$!d')" || true
	# A command substitution in argument position discards its exit status even
	# under set -e, so an empty result here would publish an empty release that
	# the repair below never redoes: the release exists.
	[[ -n $out ]] || out="Release $1"
	printf '%s' "$out"
}

latest_tag="$(git tag --list 'v[0-9]*' --sort=-v:refname | head -1 || true)"
if [[ -n $latest_tag ]] && ! gh release view "$latest_tag" >/dev/null 2>&1; then
	echo "$latest_tag has no release: creating it"
	gh release create "$latest_tag" --title "$latest_tag" --notes "$(notes "$latest_tag")" ||
		echo "could not create the release for $latest_tag; create it by hand" >&2
fi

current="$(uv version --short)"

# The shape check is what stops 0.0.0 being tagged before a real version exists.
if [[ $current =~ ^[0-9]{4}\.[0-9]{1,2}\.[0-9]+$ ]] &&
	! git rev-parse -q --verify "refs/tags/v$current" >/dev/null; then
	echo "pyproject is at $current with no tag: the release PR merged"
	git tag -a "v$current" -m "v$current"
	git push origin "v$current"
	gh release create "v$current" --title "v$current" --notes "$(notes "v$current")"
	exit 0
fi

# Nothing the changelog would show means nothing to churn the release branch for.
if [[ -z "$(git-cliff --unreleased --strip all 2>/dev/null)" ]]; then
	echo "nothing unreleased worth shipping"
	exit 0
fi

year="$(date -u +%Y)"
month="$(date -u +%-m)"
if [[ $current == "$year.$month."* ]]; then
	next="$year.$month.$((${current##*.} + 1))"
else
	next="$year.$month.0"
fi
echo "preparing $next"

git checkout -B release
uv version "$next"
git-cliff --tag "v$next" -o CHANGELOG.md
git add -A
git commit -m "chore: release $next"
git push -f origin release

body="$(git-cliff --unreleased --tag "v$next" --strip all | sed '/^## \[/d' | sed '/./,$!d')"
pr="$(gh pr list --base main --head release --state open --json number --jq '.[0].number // empty')"
if [[ -n $pr ]]; then
	gh pr edit "$pr" --title "chore: release $next" --body "$body" --add-label release
else
	gh pr create --base main --head release --label release --title "chore: release $next" --body "$body"
fi
